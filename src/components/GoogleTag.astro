---
interface Props {
  id?: string;
}

const { id = import.meta.env.PUBLIC_GOOGLE_TAG_ID } = Astro.props;
const tagId = id?.trim();
const loaderUrl = tagId
  ? 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(tagId)
  : undefined;

const inlineCode = tagId
  ? [
      'window.dataLayer = window.dataLayer || [];',
      'function gtag(){dataLayer.push(arguments);}',
      "gtag('js', new Date());",
      "gtag('config', " + JSON.stringify(tagId) + ");",
    ].join('\n')
  : '';
---

{tagId && loaderUrl && (
  <>
    <script type="text/partytown" src={loaderUrl}></script>
    <script type="text/partytown" is:inline set:html={inlineCode}></script>
  </>
)}
